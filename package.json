{
  "name": "pustakakita",
  "version": "1.0.0",
  "private": true,
  "description": "PustakaKita — sistem katalog dan sirkulasi perpustakaan mini dengan tiga peran pengguna (admin, petugas, anggota)",
  "type": "commonjs",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
