# Salin menjadi .env lalu sesuaikan.
# Port aplikasi web
PORT=3000

# Koneksi MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpw
DB_NAME=pustakakita

# Kunci penandatangan sesi — WAJIB diganti dengan nilai acak di server produksi.
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Set "production" pada server produksi agar cookie sesi memakai flag Secure.
NODE_ENV=development
