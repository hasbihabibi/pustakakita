# Salin menjadi .env lalu sesuaikan.
# Port aplikasi web
PORT=3000

# Koneksi MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=rootpw
DB_NAME=pustakakita

# Kunci penandatangan sesi — WAJIB diganti dengan nilai acak di server produksi.
# Aplikasi menolak berjalan bila NODE_ENV=production tanpa nilai ini.
SESSION_SECRET=ganti-dengan-string-acak-panjang-minimal-32-karakter

# Set "production" pada server produksi agar cookie sesi memakai flag Secure
# dan header HSTS ikut dikirim.
NODE_ENV=development

# Jumlah hop proxy tepercaya di depan aplikasi (Vercel/nginx).
# Kosong = 0 di lokal dan 1 di produksi. Isi "false" bila tidak memakai proxy.
TRUST_PROXY=
