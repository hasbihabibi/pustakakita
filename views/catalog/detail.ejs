<%- include('../partials/header') %>

<p class="small muted mb-2"><a href="/">Katalog</a> / <%= book.kategori %> / <strong><%= book.kode %></strong></p>

<div class="detail-grid">
  <div>
    <div class="detail-cover">
      <%- include('../partials/book-cover', { book: book }) %>
    </div>

    <div class="card mt-2">
      <div class="card-body">
        <dl class="meta-list" style="margin-top:0;">
          <div class="meta-row"><dt>Kode</dt><dd><%= book.kode %></dd></div>
          <div class="meta-row"><dt>Kategori</dt><dd><%= book.kategori %></dd></div>
          <div class="meta-row"><dt>Penerbit</dt><dd><%= book.penerbit || '—' %></dd></div>
          <div class="meta-row"><dt>Tahun</dt><dd><%= book.tahun_terbit || '—' %></dd></div>
          <div class="meta-row"><dt>Stok tersedia</dt><dd><%= book.stok_tersedia %> / <%= book.stok_total %> eks</dd></div>
          <div class="meta-row"><dt>Total dipinjam</dt><dd><%= totalPinjam %> kali</dd></div>
          <div class="meta-row" style="border-bottom:0;"><dt>Rating</dt><dd>★ <%= Number(book.rata_rata).toFixed(1) %> (<%= book.jumlah_ulasan %> ulasan)</dd></div>
        </dl>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card-body">
        <span class="book-kategori"><%= book.kategori %></span>
        <h1 style="margin-top:6px;"><%= book.judul %></h1>
        <p class="muted mt-1">oleh <strong><%= book.penulis %></strong><% if (book.unggulan) { %> · <span class="badge badge-terra">Koleksi unggulan</span><% } %></p>

        <p class="mt-2"><%= book.deskripsi %></p>

        <hr class="divider">

        <% if (role === 'anggota') { %>
          <% if (activeLoan) { %>
            <div class="alert alert-info">
              <span>Anda sedang meminjam buku ini. Jatuh tempo <strong><%= formatDate(activeLoan.tanggal_jatuh_tempo) %></strong>.</span>
            </div>
            <a class="btn btn-outline" href="/pinjaman-saya">Lihat pinjaman saya</a>
          <% } else if (book.stok_tersedia > 0) { %>
            <form method="post" action="/buku/<%= book.id %>/pinjam">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <p class="small muted mb-1">
                Peminjaman berlaku 7 hari. Pinjaman aktif Anda: <%= pinjamanAktif %> dari maksimal <%= maksPinjaman %> buku.
              </p>
              <button class="btn btn-primary" type="submit">Pinjam buku ini</button>
            </form>
          <% } else { %>
            <button class="btn btn-primary" type="button" disabled>Stok habis</button>
            <p class="small muted mt-1">Seluruh eksemplar sedang dipinjam. Hubungi petugas untuk daftar tunggu.</p>
          <% } %>

          <hr class="divider">

          <% if (sudahDibaca) { %>
            <h2 id="ulasan"><%= myRating ? 'Perbarui rating Anda' : 'Beri rating buku ini' %></h2>
            <p class="small muted mt-1">Anda sudah menyelesaikan buku ini. Rating membantu pembaca lain memilih bacaan.</p>
            <form method="post" action="/buku/<%= book.id %>/ulasan" class="mt-2">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field">
                <span class="label">Rating</span>
                <div class="star-input">
                  <% for (let i = 5; i >= 1; i -= 1) { %>
                    <input type="radio" id="bintang-<%= i %>" name="nilai" value="<%= i %>"
                           <%= (myRating ? myRating.nilai : 0) === i ? 'checked' : '' %> required>
                    <label for="bintang-<%= i %>" title="<%= i %> bintang"><span aria-hidden="true">★</span><span class="sr-only"><%= i %></span></label>
                  <% } %>
                  <span class="small muted" style="align-self:center; margin-left:8px;">1 – 5 bintang</span>
                </div>
              </div>
              <div class="field mt-2">
                <label class="label" for="ulasan-teks">Ulasan (opsional)</label>
                <textarea class="textarea" id="ulasan-teks" name="ulasan" maxlength="500"
                          placeholder="Apa yang paling berkesan dari buku ini?"><%= myRating && myRating.ulasan ? myRating.ulasan : '' %></textarea>
                <span class="hint">Maksimal 500 karakter.</span>
              </div>
              <button class="btn btn-accent mt-2" type="submit"><%= myRating ? 'Simpan perubahan' : 'Kirim rating' %></button>
            </form>
          <% } else { %>
            <div class="alert alert-info">
              <span>Rating dapat diberikan setelah Anda meminjam dan mengembalikan buku ini.</span>
            </div>
          <% } %>
        <% } else { %>
          <a class="btn btn-primary" href="/kelola/buku/<%= book.id %>/edit">Edit buku ini</a>
        <% } %>

        <% if (waUrl) { %>
          <a class="btn btn-outline mt-2" target="_blank" rel="noopener" href="<%= waUrl %>">Tanya via WhatsApp</a>
        <% } %>
      </div>
    </div>

    <div class="card section-gap">
      <div class="card-head">
        <h2>Ulasan pembaca</h2>
        <span class="badge badge-netral"><%= reviews.length %> ulasan</span>
      </div>
      <div class="card-body">
        <% if (reviews.length === 0) { %>
          <p class="small muted">Belum ada ulasan untuk buku ini.</p>
        <% } else { %>
          <% reviews.forEach(function (review) { %>
            <div class="review">
              <div class="review-head">
                <span class="review-author"><%= review.nama %></span>
                <span class="review-date"><%= formatDate(review.created_at) %></span>
              </div>
              <div class="stars-display" aria-label="<%= review.nilai %> dari 5 bintang"><%= stars(review.nilai) %></div>
              <% if (review.ulasan) { %><p class="review-text"><%= review.ulasan %></p><% } %>
            </div>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
